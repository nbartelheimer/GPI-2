# Per-rank shim, launched once per task by gaspi_run.slurm's srun. It maps the
# Slurm step identity to the GASPI environment and execs the program.
#
# ARGS:
#   1     : machine file (GASPI_MFILE)
#   2     : set NUMA? (0/1)
#   3     : program
#   4...  : program arguments

MFILE="$1"
SET_NUMA="$2"
PROGRAM="$3"
shift 3

export GASPI_SOCKET="${SLURM_LOCALID:-0}"
export GASPI_NRANKS="${SLURM_NTASKS:-1}"
export GASPI_RANK="${SLURM_PROCID:-0}"
export GASPI_MFILE="$MFILE"
export GASPI_SET_NUMA_SOCKET="$SET_NUMA"

# GASPI_TRACE is global and arrives via the environment (srun forwards it).
# Re-export for robustness under restrictive --export / SLURM_EXPORT_ENV.
if [ -n "${GASPI_TRACE:-}" ]; then
    export GASPI_TRACE
fi

# exec preserves argv boundaries (no string flattening of the program args).
exec "$PROGRAM" "$@"
