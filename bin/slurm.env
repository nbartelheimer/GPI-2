# ARGS:
# 1: machine file location
# 2: set NUMA?
# 3 and beyond: binary program <args>

program=$3
ARGS=""

count=1
for i in "$@"
do
    if [ $count -gt 3 ]; then
        ARGS="$ARGS ${i}"
    fi
    count=$((count+1))
done

export GASPI_SOCKET="$SLURM_LOCALID"
export GASPI_NRANKS="$SLURM_NPROCS"
export GASPI_RANK="$SLURM_PROCID"
export GASPI_MFILE="$1"
export GASPI_SET_NUMA_SOCKET="$2"

# GASPI_TRACE is global and arrives via the environment (srun forwards it),
# not as a positional argument. Re-export it for robustness in case the site
# restricts srun's environment propagation (--export / SLURM_EXPORT_ENV).
if [ -n "${GASPI_TRACE:-}" ]; then
    export GASPI_TRACE
fi

$program "$ARGS"
