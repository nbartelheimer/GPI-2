PRG=$(/bin/cat /tmp/.last_gaspi_prg 2> /dev/null)
MFILE=""

#helper functions
usage()
{
    echo "The gaspi_cleanup utility tries to kill the last run GASPI application."
    echo "This can be useful if the application was interrupted or finished unproperly."
    echo "Some resources might still be in use (particularly on remote nodes)."
    echo "For instance, a necessary port might still be in use."
    echo "Note: there is no guarantee for this operations to be always successful."
    echo
    echo "Usage: gaspi_cleanup -m <machinefile>"
    echo "OR"
    echo "gaspi_cleanup --machinefile <machinefile>"
    echo
    echo "Other options:"
    echo "   -c, --check       Only check if GASPI program is running on hosts."
    echo "   -h, --help        This help."
    echo
}

validate_machinefile()
{
    #empty
    if [ ! -s "$MFILE" ]; then
        echo "Empty machine file ($1)"
        exit 1
    fi

    GASPI_HOSTS=$(uniq "$1")

    for i in $GASPI_HOSTS
    do
        if ! ping -c 1 "$i" > /dev/null 2>&1 ; then
           echo "Host not reachable ($i)"
        fi
    done
}

kill_procs()
{
    GASPI_PRG=$(basename "$1")
    GASPI_HOSTS=$(uniq "$2")

    for i in $GASPI_HOSTS
    do
        ssh "$i" killall -s KILL "$1" "$GASPI_PRG" lt-"$GASPI_PRG" > /dev/null 2>&1 &
    done
    wait
}

check_gaspi_procs()
{
    GASPI_PRG=$(basename "$1")
    GASPI_HOSTS=$(uniq "$2")

    for i in $GASPI_HOSTS
    do
        if ssh "$i" "pgrep -x ${GASPI_PRG}  > /dev/null 2>&1"; then
            echo ${GASPI_PRG} "running on ${i}"
        fi
    done
}

#at least we need machinefile
if [ $# -lt 2 ]; then
    echo "Error: You need to provide a machinefile (-m option). Use -h or --help to view options."
    exit 1
fi


if [ "$PRG" = "" ]; then
    echo "Error: GASPI application to cleanup not found."
    exit 1
fi

check_only_option=0
while [ "$1" != "" ]; do
    case $1 in
        -c | --check)
            check_only_option=1
            ;;
	-h | --help)
	    usage
	    exit 0
	    ;;
        -m | --machinefile)
            shift
            if [ -r "$1" ]; then
                MFILE=$1
            else
                echo "Error: Cannot read file $1 (-m option) (or file does not exist)"
                exit 1
            fi
            ;;
        -* | --*)
            echo "Error: Unknown option $1. Use -h or --help for help."
            exit 1
            ;;
        *)
            echo "Error: Unknown option $1. Use -h or --help for help."
            exit 1
            ;;
    esac
    shift
done

if [ $check_only_option = 1 ]; then
    check_gaspi_procs $PRG $MFILE
else
    validate_machinefile "$MFILE"
    kill_procs "$PRG" "$MFILE"
fi

exit 0
