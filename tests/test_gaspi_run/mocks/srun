#!/bin/bash
# Mock srun for the gaspi_run.slurm trace tests.
#
# Logs the invocation (including any GASPI_TRACE forwarded through the
# environment) and then runs the wrapper + binary locally so that env
# propagation down to the GASPI process can be observed by the tests.

echo "MOCK_SRUN args=$* GASPI_TRACE=${GASPI_TRACE:-<unset>}" >> "$MOCK_LOG"

# Strip the leading "-n N -N M" launcher flags; what remains is
# "<wrapper> <mfile> <set_numa> <prg> [args...]" which we exec directly.
while [ $# -gt 0 ]; do
    case "$1" in
        -n|-N) shift 2 ;;
        *) break ;;
    esac
done

exec "$@"
